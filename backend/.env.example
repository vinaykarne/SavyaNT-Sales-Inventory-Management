# Flask Environment Configuration
FLASK_APP=run.py
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production
PORT=5000

# Database Configuration (MySQL 8.0+)
# Replace the placeholders below with your local MySQL credentials
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=your_mysql_username
DB_PASSWORD=your_mysql_password
DB_NAME=savya_inventory_db

# SQLAlchemy Database URI (assembled from components or provided directly)
DATABASE_URL=mysql+pymysql://your_mysql_username:your_mysql_password@127.0.0.1:3306/savya_inventory_db?charset=utf8mb4

# Dedicated Test Database URI (isolated database for running automated test suites)
TEST_DATABASE_URL=mysql+pymysql://your_mysql_username:your_mysql_password@127.0.0.1:3306/savya_inventory_test_db?charset=utf8mb4

# JWT Authentication Configuration
JWT_SECRET_KEY=change-this-to-a-secure-jwt-secret-key-in-production
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=480
JWT_REFRESH_TOKEN_EXPIRES_DAYS=30

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# Optional: Initial Seed Admin/Sales Credentials (used strictly by manual seed script)
SEED_ADMIN_EMAIL=admin@savya.com
SEED_ADMIN_PASSWORD=AdminPassword123!
SEED_SALES_EMAIL=sales@savya.com
SEED_SALES_PASSWORD=SalesPassword123!
